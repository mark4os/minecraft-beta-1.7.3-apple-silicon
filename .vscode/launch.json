{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Minecraft Beta 1.7.3 (Apple Silicon)",
            "request": "launch",
            "mainClass": "net.minecraft.client.Minecraft",
            "projectName": "minecraft-b1.7.3-arm64",
            "vmArgs": "-XstartOnFirstThread -Xms512M -Xmx1G -XX:+AlwaysPreTouch -XX:+UseG1GC -XX:MaxGCPauseMillis=5 -XX:-UsePerfData -Djava.awt.headless=true -Dminecraft.dir=${workspaceFolder}/run -Dorg.lwjgl.util.Debug=false",
            "workingDirectory": "${workspaceFolder}/run"
        }
    ]
}

